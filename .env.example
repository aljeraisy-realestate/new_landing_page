# Public values: add the actual app URLs whenever ready.
VITE_APP_STORE_URL=
VITE_PLAY_STORE_URL=
# Private server values. Never prefix these with VITE_.
# Use at least 3 characters for the username and 4 for the password.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Private runtime URL prefix: one lowercase path segment, without a trailing slash.
# The chosen value is never embedded in the public build. /admin is disabled.
ADMIN_PATH=/control-center
# Required: 64 random hexadecimal characters (32 cryptographically random bytes).
# Keep this secret stable across restarts; changing it invalidates admin sessions.
ADMIN_JWT_SECRET=
# Optional locally: defaults to http://localhost:3000. Set your HTTPS origin publicly.
APP_ORIGIN=
SQLITE_PATH=data/couriers.sqlite
# Optional host binding. Port is always 3000; no PORT environment variable is needed.
# HOST=127.0.0.1
